# Root-level ignores (backend/ and frontend/ have their own too).

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Secrets (never commit)
**/.env
**/.env.local
**/.env.*.local

# Python
**/__pycache__/
**/.venv/
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
**/.coverage
**/htmlcov/
**/*.db

# Node
**/node_modules/
**/dist/

# Local file storage
backend/storage/
