# ===========================================================================
# AI Career Interview Platform — Backend Environment Template
#
# Copy to `.env.local` and fill in real values for local development.
# NEVER commit `.env`, `.env.local`, or any file containing real secrets.
# See docs/08-deployment/environment-variables.md for the full reference.
# ===========================================================================

# --- Application ------------------------------------------------------------
APP_NAME="AI Career Interview Platform"
APP_VERSION="1.0.0"
APP_ENV="local"                 # local | ci | staging | production
HOST="0.0.0.0"
PORT="8000"
API_V1_PREFIX="/api/v1"

# --- Database (REQUIRED) ----------------------------------------------------
# A plain postgresql:// URL is auto-normalised to the asyncpg driver.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/interview_ai"
DATABASE_POOL_SIZE="10"
DATABASE_MAX_OVERFLOW="20"
DATABASE_POOL_TIMEOUT="30"
DATABASE_ECHO="false"

# --- Google OAuth (REQUIRED) ------------------------------------------------
# The redirect URI is the BACKEND callback (Google redirects here; the backend
# then redirects the browser to the SPA with tokens). Register this exact value
# in the Google Cloud console under "Authorized redirect URIs".
GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"
GOOGLE_REDIRECT_URI="http://localhost:8000/api/v1/auth/google/callback"

# --- JWT (REQUIRED) ---------------------------------------------------------
# Generate a strong secret, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY="change_me_to_a_random_48_char_minimum_secret_value_xxxxx"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES="30"
JWT_REFRESH_TOKEN_EXPIRE_DAYS="30"

# --- Groq AI (REQUIRED) -----------------------------------------------------
GROQ_API_KEY="your_groq_api_key_here"
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_TRANSCRIPTION_MODEL="whisper-large-v3"
GROQ_REASONING_EFFORT="medium"   # low | medium | high (gpt-oss reasoning depth)
GROQ_TIMEOUT="60"
GROQ_MAX_RETRIES="3"

# --- Object storage ---------------------------------------------------------
STORAGE_PROVIDER="local"        # local | s3 (s3 = any S3-compatible incl. Cloudflare R2)
STORAGE_LOCAL_DIR="storage"
MAX_UPLOAD_SIZE_BYTES="5242880" # 5 MB
# Required only when STORAGE_PROVIDER=s3:
STORAGE_BUCKET=""
STORAGE_ENDPOINT=""             # e.g. https://<account>.r2.cloudflarestorage.com
STORAGE_REGION="auto"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# --- Security ---------------------------------------------------------------
CORS_ALLOWED_ORIGINS="http://localhost:5173"
ALLOWED_HOSTS="*"
RATE_LIMIT_PER_MINUTE="100"
# The SPA origin the backend redirects to after a successful OAuth login.
FRONTEND_URL="http://localhost:5173"

# --- Logging ----------------------------------------------------------------
LOG_LEVEL="INFO"
LOG_FORMAT="console"            # json | console (use json in deployed envs)
ENABLE_REQUEST_LOGGING="true"

# --- Feature flags ----------------------------------------------------------
ENABLE_AI_FEEDBACK="true"
ENABLE_HEALTH_CHECKS="true"


