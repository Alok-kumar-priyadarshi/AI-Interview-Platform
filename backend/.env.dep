# ===========================================================================
# AI Career Interview Platform — Backend PRODUCTION env template (.env.dep)
#
# This documents the variables to set on your hosting platform (Railway) for a
# PRODUCTION deployment. DO NOT put real secrets in this file — it is a guide.
# Set the real values in the platform's Variables/Secrets UI.
#
# Replace every <PLACEHOLDER> below.
#   <BACKEND_URL>   e.g. https://api.yourdomain.com   (this service's public URL)
#   <FRONTEND_URL>  e.g. https://app.yourdomain.com   (the Vercel SPA URL)
# ===========================================================================

# --- Application ------------------------------------------------------------
APP_ENV=production
APP_NAME=AI Career Interview Platform
APP_VERSION=1.0.0
# Railway/Render inject PORT automatically; do NOT hardcode it.

# --- Database (REQUIRED) ----------------------------------------------------
# Use your managed PostgreSQL connection string (Railway Postgres, Supabase,
# Neon, RDS, …). A plain postgresql:// URL is auto-normalised to asyncpg.
DATABASE_URL=<MANAGED_POSTGRES_CONNECTION_STRING>
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# --- Google OAuth (REQUIRED) ------------------------------------------------
# Register this EXACT redirect URI in Google Cloud Console → Credentials:
#   <BACKEND_URL>/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=<GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<GOOGLE_CLIENT_SECRET>
GOOGLE_REDIRECT_URI=<BACKEND_URL>/api/v1/auth/google/callback

# --- JWT (REQUIRED) ---------------------------------------------------------
# A strong, unique secret (≥ 32 chars). Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=<STRONG_RANDOM_SECRET_48_CHARS>
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Groq AI (REQUIRED) -----------------------------------------------------
GROQ_API_KEY=<GROQ_API_KEY>
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3

# --- Object storage (RECOMMENDED for production) ----------------------------
# Production runs are stateless — do NOT rely on local disk. Use Cloudflare R2
# (or any S3-compatible service) so resume/audio/PDF files persist.
STORAGE_PROVIDER=s3
STORAGE_BUCKET=<R2_BUCKET_NAME>
STORAGE_ENDPOINT=https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=<R2_ACCESS_KEY_ID>
STORAGE_SECRET_KEY=<R2_SECRET_ACCESS_KEY>
MAX_UPLOAD_SIZE_BYTES=10485760

# --- Security (REQUIRED) ----------------------------------------------------
# Comma-separated list of allowed browser origins = your deployed frontend(s).
CORS_ALLOWED_ORIGINS=<FRONTEND_URL>
# The SPA origin the backend redirects to after a successful OAuth login.
FRONTEND_URL=<FRONTEND_URL>
# Restrict to this service's host(s) in production (comma-separated).
ALLOWED_HOSTS=<BACKEND_HOST_WITHOUT_SCHEME>
# HTTPS in production → secure cookies ON.
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
RATE_LIMIT_PER_MINUTE=100

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json                    # structured logs in production
ENABLE_REQUEST_LOGGING=true

# --- Feature flags ----------------------------------------------------------
ENABLE_AI_FEEDBACK=true
ENABLE_HEALTH_CHECKS=true

# ===========================================================================
# Deploy checklist (Railway):
#   1. Add all variables above (real values) under the service Variables.
#   2. railway.toml runs: alembic upgrade head → uvicorn app.main:app
#   3. Health check path: /api/v1/health/live
#   4. In Google console, add <BACKEND_URL>/api/v1/auth/google/callback as an
#      Authorized redirect URI, and publish the OAuth consent screen.
# ===========================================================================
