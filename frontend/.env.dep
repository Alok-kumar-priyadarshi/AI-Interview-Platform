# ===========================================================================
# AI Career Interview Platform — Frontend PRODUCTION env template (.env.dep)
#
# Set these on Vercel (Project → Settings → Environment Variables) for the
# Production environment. The frontend has NO secrets — all VITE_* values are
# public and shipped to the browser.
#
# Replace <BACKEND_URL> with your deployed backend base URL, e.g.
#   https://api.yourdomain.com   (a Railway service URL is fine too)
# ===========================================================================

# The backend API base URL, INCLUDING the /api/v1 path.
#   Local:      http://localhost:8000/api/v1
#   Production: <BACKEND_URL>/api/v1
VITE_API_BASE_URL=<BACKEND_URL>/api/v1

VITE_APP_NAME=AI Career Interview Platform
VITE_APP_ENV=production

# ===========================================================================
# Deploy checklist (Vercel):
#   1. Framework preset: Vite (vercel.json already configures build + SPA
#      rewrites). Root directory: frontend/
#   2. Set VITE_API_BASE_URL above to <BACKEND_URL>/api/v1 for Production.
#   3. After deploy, copy the Vercel URL and set it on the BACKEND as:
#        FRONTEND_URL           = https://<your-vercel-app>.vercel.app
#        CORS_ALLOWED_ORIGINS   = https://<your-vercel-app>.vercel.app
#   4. Ensure the Google OAuth redirect URI points at the BACKEND callback
#      (<BACKEND_URL>/api/v1/auth/google/callback), not the frontend.
# ===========================================================================
